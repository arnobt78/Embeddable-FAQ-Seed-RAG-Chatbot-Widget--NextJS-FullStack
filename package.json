    "type": "git",
    "url": "https://github.com/arnobt78/portfolio-chatbot-widget.git"
  },
  "keywords": [
    "chatbot",
    "rag",
    "nextjs",
    "react",
    "ai",
    "widget",
    "portfolio",
    "embeddable",
    "redis",
    "vector-search",
    "openai",
    "groq",
    "google-ai",
    "open-source",
    "typescript",
    "tailwindcss"
