{
  "name": "portfolio-chatbot-widget",
  "version": "0.1.0",
  "description": "A production-ready, self-hosted RAG (Retrieval Augmented Generation) chatbot widget built with Next.js, Redis vector storage, and multiple AI model fallbacks. Perfect for embedding into portfolio websites or any web application.",
  "author": {
    "name": "Arnob Mahmud",
